// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id   String @id @default(uuid())
  name String @unique
  kode String @unique

  user User[]

  @@map("roles")
}

enum Gender {
  male
  female
  other
}

model Hospital {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(255)
  logo_path String?

  user           User[]
  satu_sehat_env SatuSehatEnv?

  @@map("hospitals")
}

model SatuSehatEnv {
  id              String  @id @default(uuid())
  organization_id String? @db.LongText
  client_id       String? @db.LongText
  client_secret   String? @db.LongText
  access_token    String? @db.LongText

  hospital_id String @unique

  hospital Hospital @relation(fields: [hospital_id], references: [id])

  @@map("satu_sehat_env")
}

model User {
  id             String    @id @default(uuid())
  username       String    @unique
  password       String    @db.VarChar(255)
  email          String?   @db.VarChar(50)
  nik            String?   @unique @db.VarChar(50)
  ihs_number     String?   @db.VarChar(100)
  name           String    @db.VarChar(255)
  place_of_birth String?   @db.VarChar(255)
  date_of_birth  DateTime? @db.DateTime()
  gender         Gender
  address_id     String
  phone          String?   @db.VarChar(16)
  last_education String?   @db.VarChar(255)
  experience     String?   @db.VarChar(10)
  speciality     String?   @db.VarChar(255)
  token          String?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  role_id     String
  hospital_id String
  gateway_id  String?

  hospital Hospital    @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  role     Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)
  address  Address     @relation(fields: [address_id], references: [id])
  gateway  IotGateway? @relation(fields: [gateway_id], references: [id])

  patient_handler PatientHandler[]
  activity_log    ActivityLogs[]
  profile_picture ProfilePicture?

  @@map("users")
}

model IotGateway {
  id          String   @id @db.VarChar(255)
  ip_address  String?
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt()
  status      Boolean  @default(false)
  uptime      String?  @db.VarChar(255)
  firmware    String?  @db.VarChar(50)

  room_id     String?

  room             Room?          @relation(fields: [room_id], references: [id], onDelete: Cascade)
  device_connected DeviceConnected[]
  user             User[]

  @@map("iot_gateways")
}

model ProfilePicture {
  id   Int    @id @default(autoincrement())
  path String

  user_id String @unique

  user User @relation(fields: [user_id], references: [id])

  @@map("profile_pictures")
}

model DeviceConnected {
  id                String         @id @default(uuid())
  mac_address       String?
  ip_address        String?
  type              String?
  name              String         @db.VarChar(255)
  model             String         @db.VarChar(100)
  device_function   String         @db.VarChar(100)
  connection        ConnectionType
  is_connected      Boolean
  count_used        Int?           @default(0)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @default(now()) @updatedAt()

  gateway_id String
  gateway         IotGateway       @relation(fields: [gateway_id], references: [id])
  patient_handler PatientHandler[]
  parameters      DeviceParameter[]

  @@map("devices_connected")
}

model DeviceParameter {
  id          String               @id @default(uuid())
  device_id   String
  parameter   MeasurementParameter

  device      DeviceConnected      @relation(fields: [device_id], references: [id])

  @@unique([device_id, parameter])

  @@map("device_parameters")
}

enum MeasurementParameter {
  // Antropometri
  BODY_WEIGHT
  BODY_HEIGHT
  BMI
  BODY_TEMPERATURE

  // Tekanan Darah
  BLOOD_PRESSURE

  // Jantung & Sirkulasi
  HEART_RATE
  FETAL_HEART_RATE
  PULSE_RATE

  // Respirasi & Oksigen
  RESPIRATORY_RATE
  SPO2

  // Elektrofisiologi & Monitoring
  ECG
  PLETHYSMOGRAM

  // Central Monitoring
  PATIENT_MONITOR
  VITAL_SIGN_MONITOR
}

enum ConnectionType {
  bluetooth
  tcpip
  usb_hid
  usb_vcp
  flashdisk
  ftp
  udpip
  other
}

model PatientHandler {
  id         String   @id @default(uuid())
  user_id    String
  patient_id String
  device_id  String
  timestamp  DateTime @default(now()) @updatedAt

  user             User            @relation(fields: [user_id], references: [id])
  patient          Patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  device_connected DeviceConnected @relation(fields: [device_id], references: [id], onDelete: Cascade)

  measurement_histories_digit_pro_baby MeasurementHistoriesDigitProBaby[]
  measurement_histories_digit_pro_ida  MeasurementHistoriesDigitProIda[]
  measurement_histories_digit_pro_bmi  MeasurementHistoriesDigitProBMI[]
  measurement_histories_doppler        MeasurementHistoriesDoppler[]
  measurement_histories_mft01        MeasurementHistoriesMft01[]
  measurement_histories_tensione        MeasurementHistoriesTensione[]
  measurement_histories_pulse_oximeter_fox1        MeasurementHistoriesPulseOximeterFox1[]
  measurement_histories_ptb_digi        MeasurementHistoriesPTBDigi[]
  measurement_histories_mtr_baby002        MeasurementHistoriesMTRBaby002[]
  central_monitor                      CentralMonitor[]
  measurement_histories_pm9000         MeasurementHistoriesPM9000[]
  measurement_histories_ds001          MeasurementHistoriesDS001[]
  measurement_activity                 MeasurementActivity[]
  history_measurement                  HistoriesMeasurement[]
  recent_measurement                   RecentMeasurement[]
  last_nibp                            LastNibp?
  ecg_1200g                            Ecg1200g?

  @@map("patient_handlers")
}

model Patient {
  id             String   @id @default(uuid())
  nik            String?   @unique
  no_kk          String?  @db.VarChar(50)
  ihs_number     String?  @db.VarChar(100)
  barcode_img    String   @db.LongText
  name           String   @db.VarChar(255)
  gender         Gender
  phone          String?  @db.VarChar(16)
  place_of_birth String?  @db.VarChar(50)
  date_of_birth  DateTime @db.DateTime()
  condition      String?  @db.VarChar(20)
  address_id     String
  mother_id      String?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  address           Address           @relation(fields: [address_id], references: [id])
  patient_handler   PatientHandler[]
  babies            Patient[]         @relation("mother_to_baby")
  mother            Patient?          @relation("mother_to_baby", fields: [mother_id], references: [id])
  patient_room      PatientRoom?
  last_measurement  LastMeasurementPatient?

  parent_id String?

  @@map("patients")
}

model Address {
  id          String   @id @default(uuid())
  use         String   @db.VarChar(20)
  line        String   @db.LongText
  city        String   @db.VarChar(255)
  postal_code String   @db.VarChar(10)
  country     String   @db.VarChar(10)
  rt          String   @db.VarChar(3)
  rw          String   @db.VarChar(3)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  province_id String @db.Char(2)
  regency_id  String @db.Char(4)
  district_id String @db.Char(7)
  village_id  String @db.Char(10)

  province Province @relation(fields: [province_id], references: [id])
  regency  Regency  @relation(fields: [regency_id], references: [id])
  district District @relation(fields: [district_id], references: [id])
  village  Village  @relation(fields: [village_id], references: [id])

  patient Patient[]
  user    User[]

  @@map("addresses")
}

model Province {
  id        String    @id @db.Char(2)
  name      String    @db.VarChar(255)
  regencies Regency[]
  Address   Address[]

  @@map("provinces")
}

model Regency {
  id          String     @id @db.Char(4)
  name        String     @db.VarChar(255)
  province_id String     @db.Char(2)
  province    Province   @relation(fields: [province_id], references: [id])
  districts   District[]
  addresses   Address[]

  @@map("regencies")
}

model District {
  id         String    @id @db.Char(7)
  name       String    @db.VarChar(255)
  regency_id String    @db.Char(4)
  regency    Regency   @relation(fields: [regency_id], references: [id])
  villages   Village[]
  addresses  Address[]

  @@map("districts")
}

model Village {
  id          String    @id @db.Char(10)
  name        String    @db.VarChar(255)
  district_id String    @db.Char(7)
  district    District  @relation(fields: [district_id], references: [id])
  addresses   Address[]

  @@map("villages")
}

model Baby {
  id                  String   @id @default(uuid())
  ihs_number          String?  @unique
  multi_birth_integer Int      @default(0)
  name                String   @db.VarChar(255)
  gender              Gender
  date_of_birth       DateTime @db.DateTime()
  place_of_birth      String?  @db.VarChar(50)

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  patient_id String


  @@map("babies")
}

model PatientRoom {
  id            String    @id @default(uuid())
  bed_id        String    @unique
  room_id       String
  patient_id    String    @unique
  assigned_at   DateTime  @db.DateTime()
  discharged_at DateTime? @db.DateTime()

  patient           Patient           @relation(fields: [patient_id], references: [id])
  room              Room              @relation(fields: [room_id], references: [id])
  bed               Bed               @relation(fields: [bed_id], references: [id])

  @@map("patient_rooms")
}

model ActivityRoomLog {
  id              String   @id @default(uuid())
  room_id         String
  activity        String   @db.LongText
  timestamp       DateTime @default(now())

  patient_room Room @relation(fields: [room_id], references: [id])

  @@map("activity_room_logs")
}

model Room {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(255)
  number     String   @db.VarChar(6)
  type       String   @db.VarChar(255)
  capacity   Int      @db.Int
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  nurse_manager String?
  doctor_id     String?

  patient_room PatientRoom[]
  activity_room_log ActivityRoomLog[]
  bed          Bed[]
  iot_gateway    IotGateway[]

  @@map("rooms")
}

model Bed {
  id         String   @id @default(uuid())
  bed_number String   @db.VarChar(10)
  status     String   @db.VarChar(30)
  type       String   @db.VarChar(30)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  room_id String

  room         Room         @relation(fields: [room_id], references: [id])
  patient_room PatientRoom?

  @@map("beds")
}

model CentralMonitor {
  id                 String @id @default(uuid())
  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("central_monitors")
}



// Digit Pro Ida
model MeasurementHistoriesDigitProIda {
  id            String   @id @default(uuid())
  weight_mother Float    @db.Float
  weight_baby   Float?   @db.Float
  recorded_at   DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_digit_pro_ida")
}

// Doppler
model MeasurementHistoriesDoppler {
  id          String   @id @default(uuid())
  heart_rate  Float    @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement-histories_doppler")
}

// Digit Pro Baby
model MeasurementHistoriesDigitProBaby {
  id          String   @id @default(uuid())
  weight      Float    @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_digit_pro_baby")
}

// Digit Pro BMI
model MeasurementHistoriesDigitProBMI {
  id           String   @id @default(uuid())
  height       Float?   @db.Float
  weight       Float    @db.Float
  age          Float?   @db.Float
  bmi          Float?   @db.Float
  body_fat     Float?   @db.Float
  muscle_mass  Float?   @db.Float
  water        Float?   @db.Float
  visceral_fat Float?   @db.Float
  bone_mass    Float?   @db.Float
  metabolism   Float?   @db.Float
  protein      Float?   @db.Float
  obesity      Float?   @db.Float
  body_age     Float?   @db.Float
  lbm          Float?   @db.Float
  recorded_at  DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_digit_pro_bmi")
}

// Thermo gun MFT 01
model MeasurementHistoriesMft01 {
  id String @id @default(uuid())
  temperature Float @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_mft01")
}

// Tensi One
model MeasurementHistoriesTensione {
  id String @id @default(uuid())
  systolic Float @db.Float
  diastolic Float @db.Float
  map Float @db.Float
  pulse_rate Float @db.Float
  spo2 Float @db.Float

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_tensione")

}

// Pulse Oximeter FOX 1
model MeasurementHistoriesPulseOximeterFox1 {
  id String @id @default(uuid())
  spo2 Float @db.Float
  pulse_rate Float @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_pulse_oximeter_fox_1")
}

// PTB Digi
model MeasurementHistoriesPTBDigi {
  id String @id @default(uuid())
  distance Float @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String
  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_ptb_digi")
}

// MTR Baby 002
model MeasurementHistoriesMTRBaby002 {
  id String @id @default(uuid())
  baby_height Float @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String
  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])
}

model MeasurementHistoriesPM9000 {
  id          String   @id @default(uuid())
  ecg         Float    @db.Float
  spo2        Float    @db.Float
  resp        Float    @db.Float
  temp1       Float    @db.Float
  temp2       Float    @db.Float
  delta_temp  Float    @db.Float
  systolic    Float?   @db.Float
  diastolic   Float?   @db.Float
  mean        Float?   @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_pm9000")
}

model MeasurementHistoriesDS001 {
  id               String   @id @default(uuid())
  temp             Float    @db.Float
  spo2             Float    @db.Float
  pulse_rate_spo2  Float    @db.Float
  respiratory_rate Float    @db.Float
  systolic         Float?   @db.Float
  diastolic        Float?   @db.Float
  map              Float?   @db.Float
  pulse_rate       Float?   @db.Float
  recorded_at      DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_ds001")
}

model MeasurementActivity {
  id                 String   @id @default(uuid())
  patient_handler_id String
  title              String   @db.VarChar(255)
  description        String?  @db.LongText()
  recorded_at        DateTime @default(now())

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_activities")
}

model HistoriesMeasurement {
  id String @id @default(uuid())
  patient_handler_id String
  parameter String
  value String
  room String
  recorded_at DateTime @default(now())

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("histories_measurement")
}

model LastMeasurementPatient {
  id String @id @default(uuid())
  patient_id String @unique
  blood_pressure String?
  spo2 String?
  body_temperature String?
  body_weight String?
  body_height String?

  timestamp_blood_pressure DateTime?
  timestamp_spo2 DateTime?
  timestamp_body_temperature DateTime?
  timestamp_body_weight DateTime?
  timestamp_body_height DateTime?

  patient Patient @relation(fields: [patient_id], references: [id])

  @@map("last_measurement_patients")
}


model LastNibp {
  id                 String @id @default(uuid())
  patient_handler_id String @unique
  systolic           Float
  diastolic          Float

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("last_nibp")
}

model Ecg1200g {
  id                 String  @id @default(uuid())
  file_path          String?
  image_path         String?
  patient_handler_id String  @unique

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("ecg_1200g")
}

model RecentMeasurement {
  id String @id @default(uuid())
  patient_handler_id String @unique
  parameter Parameter
  value String @db.VarChar(100)
  room String? @db.VarChar(255)
  recorded_at DateTime @default(now())

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("recent_measurements")
}

enum Parameter {
  weight
  blood_pressure
  temperature
  sp02
}

//Activity
model ActivityLogs {
  id           String   @id @default(uuid())
  action       String
  description  String   @db.Text
  target_table String
  target_id    String?
  ip_address   String?
  user_agent   String?
  timestamp    DateTime @default(now())

  user_id String

  user User @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}
