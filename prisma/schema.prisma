// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id   String @id @default(uuid())
  name String @unique
  kode String @unique

  user User[]

  @@map("roles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Hospital {
  id        String  @id @default(uuid())
  name      String  @db.VarChar(255)
  logo_path String?

  user              User[]
  devices_connected DeviceConnected[]
  iot_gateway       IotGateway[]

  @@map("hospitals")
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String   @db.VarChar(255)
  email      String?  @db.VarChar(50)
  phone      String?  @db.VarChar(16)
  token      String?
  is_active  Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  role_id     String
  hospital_id String

  hospital Hospital @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)

  admin  Admin?  @relation("UserAdmin")
  doctor Doctor? @relation("UserDoctor")
  nurse  Nurse?  @relation("UserNurse")

  patient_handle  PatientHandler[]
  activity_log    ActivityLogs[]
  profile_picture ProfilePicture?

  @@map("users")
}

model IotGateway {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt()

  hospital_id String

  hospital        Hospital          @relation(fields: [hospital_id], references: [id], onDelete: Cascade)
  DeviceConnected DeviceConnected[]

  @@map("iot_gateways")
}

model Admin {
  name String

  user_id String @id

  user User @relation("UserAdmin", fields: [user_id], references: [id])

  @@map("admins")
}

model Doctor {
  nid                 String   @unique
  name                String
  place_of_birth      String   @db.VarChar(255)
  date_of_birth       DateTime @db.DateTime()
  gender              Gender
  address             String   @db.LongText
  last_education      String   @db.VarChar(255)
  experience_of_years String   @db.VarChar(10)
  specialty           String   @db.VarChar(255)

  user_id  String @id @unique
  admin_id String

  user  User   @relation("UserDoctor", fields: [user_id], references: [id])
  rooms Room[]

  @@map("doctors")
}

model Nurse {
  nira                String   @unique
  name                String   @db.VarChar(255)
  place_of_birth      String   @db.VarChar(50)
  date_of_birth       DateTime @db.DateTime()
  gender              Gender
  address             String   @db.LongText
  last_education      String   @db.VarChar(50)
  experience_of_years String   @db.VarChar(10)

  user_id  String @id @unique
  admin_id String

  user  User   @relation("UserNurse", fields: [user_id], references: [id])
  rooms Room[]

  @@map("nurses")
}

model ProfilePicture {
  id   Int    @id @default(autoincrement())
  path String

  user_id String @unique

  user User @relation(fields: [user_id], references: [id])

  @@map("profile_pictures")
}

model DeviceConnected {
  id              String         @id
  name            String         @db.VarChar(255)
  model           String         @db.VarChar(100)
  device_function String         @db.VarChar(100)
  type            String         @db.VarChar(100)
  connection      ConnectionType
  is_connected    Boolean
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt()

  hospital_id String
  gateway_id  String

  hospital          Hospital                @relation(fields: [hospital_id], references: [id])
  gateway           IotGateway              @relation(fields: [gateway_id], references: [id])
  connection_detail DeviceConnectionDetail?

  @@map("devices_connected")
}

enum ConnectionType {
  bluetooth
  tcp_ip
  serial
  other
}

model DeviceConnectionDetail {
  device_id     String  @id
  mac_address   String? @unique
  ip_address    String? @unique
  serial_number String? @unique

  device DeviceConnected @relation(fields: [device_id], references: [id])

  @@map("devices_connection_detail")
}

model PatientHandler {
  id         String   @id @default(uuid())
  user_id    String
  patient_id String
  device_id  String
  timestamp  DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  patient Patient @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  measurement_histories_digit_pro_baby MeasurementHistoriesDigitProBaby[]
  measurement_histories_digit_pro_ida  MeasurementHistoriesDigitProIda[]
  measurement_histories_digit_pro_bmi  MeasurementHistoriesDigitProBMI[]
  measurement_histories_doppler        MeasurementHistoriesDoppler[]
  central_monitor                      CentralMonitor[]
  measurement_histories_pm9000         MeasurementHistoriesPM9000[]
  measurement_histories_ds001          MeasurementHistoriesDS001[]
  ecg_1200g                            Ecg1200g?

  @@map("patient_handlers")
}

model Patient {
  id             String   @id @default(uuid())
  nik            String   @unique
  no_kk          String?  @db.VarChar(50)
  ihs_number     String?  @db.VarChar(100)
  barcode_img    String   @db.LongText
  name           String   @db.VarChar(255)
  gender         Gender
  phone          String?  @db.VarChar(16)
  place_of_birth String?  @db.VarChar(50)
  date_of_birth  DateTime @db.DateTime()
  height         Int?     @db.Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  address_id      String
  address         Address          @relation(fields: [address_id], references: [id])
  patient_handler PatientHandler[]
  babies          Baby[]
  patient_room    PatientRoom?

  @@map("patients")
}

model Address {
  id          String   @id @default(uuid())
  use         String   @db.VarChar(20)
  line        String   @db.LongText
  rt          String?  @db.VarChar(10)
  rw          String?  @db.VarChar(10)
  postal_code String   @db.VarChar(10)
  country     String   @db.VarChar(10)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  province_id String @db.Char(2)
  regency_id  String @db.Char(4)
  district_id String @db.Char(7)
  village_id  String @db.Char(10)

  province Province @relation(fields: [province_id], references: [id])
  regency  Regency  @relation(fields: [regency_id], references: [id])
  district District @relation(fields: [district_id], references: [id])
  village  Village  @relation(fields: [village_id], references: [id])

  patient Patient[]

  @@map("addresses")
}

model Province {
  id        String    @id @db.Char(2) // Kode wilayah KEMENDAGRI
  name      String    @db.VarChar(255)
  regencies Regency[]
  Address   Address[]

  @@map("provinces")
}

model Regency {
  id          String     @id @db.Char(4)
  name        String     @db.VarChar(255)
  province_id String     @db.Char(2)
  province    Province   @relation(fields: [province_id], references: [id])
  districts   District[]
  addresses   Address[]

  @@map("regencies")
}

model District {
  id         String    @id @db.Char(7)
  name       String    @db.VarChar(255)
  regency_id String    @db.Char(4)
  regency    Regency   @relation(fields: [regency_id], references: [id])
  villages   Village[]
  addresses  Address[]

  @@map("districts")
}

model Village {
  id          String    @id @db.Char(10)
  name        String    @db.VarChar(255)
  district_id String    @db.Char(7)
  district    District  @relation(fields: [district_id], references: [id])
  addresses   Address[]

  @@map("villages")
}

model Baby {
  id String @id @default(uuid())

  name           String   @db.VarChar(255)
  gender         Gender
  date_of_birth  DateTime @db.DateTime()
  place_of_birth String?  @db.VarChar(50)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient_id String

  patient                              Patient                            @relation(fields: [patient_id], references: [id])
  measurement_histories_digit_pro_baby MeasurementHistoriesDigitProBaby[]
  measurement_histories_digit_pro_ida  MeasurementHistoriesDigitProIda[]

  @@map("babies")
}

model PatientRoom {
  id            String    @id @default(uuid())
  bed_id        String    @unique
  room_id       String
  patient_id    String    @unique
  assigned_at   DateTime  @db.DateTime()
  discharged_at DateTime? @db.DateTime()

  patient           Patient           @relation(fields: [patient_id], references: [id])
  activity_room_log ActivityRoomLog[]
  room              Room              @relation(fields: [room_id], references: [id])
  bed               Bed               @relation(fields: [bed_id], references: [id])

  @@map("patient_rooms")
}

model ActivityRoomLog {
  id              String   @id @default(uuid())
  patient_room_id String
  activity        String   @db.LongText
  timestamp       DateTime @default(now())

  patient_room PatientRoom @relation(fields: [patient_room_id], references: [id])

  @@map("activity_room_logs")
}

model Room {
  id         String   @id
  name       String   @db.VarChar(255)
  number     String   @db.VarChar(6)
  type       String   @db.VarChar(255)
  capacity   Int      @db.Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  nurse_manager String?
  doctor_id     String?

  nurse        Nurse?        @relation(fields: [nurse_manager], references: [user_id], onDelete: Cascade)
  doctor       Doctor?       @relation(fields: [doctor_id], references: [user_id], onDelete: Cascade)
  patient_room PatientRoom[]
  bed          Bed[]

  @@map("rooms")
}

model Bed {
  id         String   @id @default(uuid())
  bed_number String   @db.VarChar(10)
  status     String   @db.VarChar(30)
  type       String   @db.VarChar(30)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  room_id String

  room         Room         @relation(fields: [room_id], references: [id])
  patient_room PatientRoom?

  @@map("beds")
}

model CentralMonitor {
  id                 String @id @default(uuid())
  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("central_monitors")
}

// Digit Pro Baby
model MeasurementHistoriesDigitProBaby {
  id          String   @id @default(uuid())
  weight      Float    @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String
  baby_id            String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])
  baby            Baby           @relation(fields: [baby_id], references: [id])

  @@map("measurement_histories_digit_pro_baby")
}

// Digit Pro Ida
model MeasurementHistoriesDigitProIda {
  id            String   @id @default(uuid())
  weight_mother Float    @db.Float
  weight_child  Float    @db.Float
  recorded_at   DateTime @default(now())

  patient_handler_id String
  baby_id            String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])
  baby            Baby           @relation(fields: [baby_id], references: [id])

  @@map("measurement_histories_digit_pro_ida")
}

// Doppler
model MeasurementHistoriesDoppler {
  id          String   @id @default(uuid())
  heart_rate  Float    @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement-histories_doppler")
}

// Digit Pro BMI
model MeasurementHistoriesDigitProBMI {
  id           String   @id @default(uuid())
  weight       Float    @db.Float
  age          Float    @db.Float
  bmi          Float    @db.Float
  body_fat     Float    @db.Float
  muscle_mass  Float    @db.Float
  water        Float    @db.Float
  visceral_fat Float    @db.Float
  bone_mass    Float    @db.Float
  metabolism   Float    @db.Float
  protein      Float    @db.Float
  obesity      Float    @db.Float
  body_age     Float    @db.Float
  lbm          Float    @db.Float
  recorded_at  DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_digit_pro_bmi")
}

model MeasurementHistoriesPM9000 {
  id          String   @id @default(uuid())
  ecg         Float    @db.Float
  spo2        Float    @db.Float
  resp        Float    @db.Float
  temp1       Float    @db.Float
  temp2       Float    @db.Float
  delta_temp  Float    @db.Float
  systolic    Float?   @db.Float
  diastolic   Float?   @db.Float
  mean        Float?   @db.Float
  recorded_at DateTime @default(now())

  patient_handler_id String

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("measurement_histories_pm9000")
}

model MeasurementHistoriesDS001 {
  id               String   @id @default(uuid())
  temp             Float    @db.Float
  spo2             Float    @db.Float
  pulse_rate_spo2  Float    @db.Float
  respiratory_rate Float    @db.Float
  systolic         Float?   @db.Float
  diastolic        Float?   @db.Float
  map              Float?   @db.Float
  pulse_rate       Float?   @db.Float
  recorded_at      DateTime @default(now())

  patient_handler_id String

  patient_handler                  PatientHandler @relation(fields: [patient_handler_id], references: [id])
  measurement_histories_ds001_nibp String?

  @@map("measurement_histories_ds001")
}

model Ecg1200g {
  id                 String  @id @default(uuid())
  file_path          String?
  image_path         String?
  patient_handler_id String  @unique

  patient_handler PatientHandler @relation(fields: [patient_handler_id], references: [id])

  @@map("ecg_1200g")
}

//Activity
model ActivityLogs {
  id           String   @id @default(uuid())
  action       String
  description  String   @db.Text
  target_table String
  target_id    String?
  ip_address   String?
  user_agent   String?
  timestamp    DateTime @default(now())

  user_id String

  user User @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}
